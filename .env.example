# Copy to .env. All vars are prefixed CRAWLER_.
# Laptop (dev) defaults are small; the VPS just bumps the concurrency/worker numbers.

# Escalation order. CANONICAL SYSTEM = 3 tiers: L1 -> L2 -> L4 (Web Unlocker catch-all).
# There is no L3 (both candidates were tested and removed — see README).
# Default below is the free system and needs zero credentials. Once you have Bright Data
# creds (key + zone, further down), switch this to: L1,L2,L4
# L2B/L2C are dormant optional modules — add them here only if you mean to.
CRAWLER_ENABLED_TIERS=L1,L2

# Throttle / concurrency  (VPS: raise these to match vCPU + IP budget)
CRAWLER_GLOBAL_CONCURRENCY=8
CRAWLER_PER_DOMAIN_CONCURRENCY=2
CRAWLER_PER_DOMAIN_MIN_INTERVAL_MS=500
CRAWLER_WORKER_COUNT=4

# Browser (L2)
CRAWLER_HEADLESS=true
# Path to a Chrome/Chromium binary.
#   Docker image: /usr/bin/chromium  (apt .deb — fine, NOT snap)
#   Bare VPS: DO NOT use snap chromium. Its slow cold start exceeds nodriver's ~3s connect
#     window under concurrency -> "Failed to connect to browser" (cold only; warm works).
#     Install standalone Chrome and point here:
#       wget https://dl.google.com/linux/direct/google-chrome-stable_current_amd64.deb
#       apt-get install -y ./google-chrome-stable_current_amd64.deb
#     CRAWLER_CHROME_PATH=/usr/bin/google-chrome-stable
#   macOS local: npx @puppeteer/browsers install chrome@stable  -> use the printed path
CRAWLER_CHROME_PATH=/usr/bin/google-chrome-stable
CRAWLER_BROWSER_CONCURRENCY=2
CRAWLER_NAV_TIMEOUT_S=25
CRAWLER_SETTLE_MS=800
CRAWLER_BLOCK_RESOURCES=true
CRAWLER_IMPERSONATE=chrome

# Classifier thresholds (tune on the benchmark)
# MIN_TEXT_LEN        L1: below this + a <script> present => unrendered shell, escalate
# MIN_RENDER_TEXT_LEN browser tiers: minimum substantive text to count as real content
# MIN_ANCHORS         same-origin links that count as a "real navigation" positive signal
CRAWLER_MIN_TEXT_LEN=200
CRAWLER_MIN_RENDER_TEXT_LEN=500
CRAWLER_MIN_ANCHORS=8

# --- Retired: residential proxy tier. Kept only so ProxyPool keeps its interface. ---
CRAWLER_PROXIES=

# --- L2C: Byparr (Turnstile worker) — URL of a running Byparr/FlareSolverr service ---
CRAWLER_BYPARR_URL=

# --- L4: Bright Data Web Unlocker. Add key+zone and L4 to ENABLED_TIERS to activate. ---
CRAWLER_WEB_UNLOCKER_URL=https://api.brightdata.com/request
CRAWLER_WEB_UNLOCKER_KEY=
CRAWLER_WEB_UNLOCKER_ZONE=

# Queue / store  (dev defaults need zero infra)
CRAWLER_QUEUE_BACKEND=memory
CRAWLER_STORE_BACKEND=sqlite
CRAWLER_DB_URL=crawler.db
CRAWLER_REDIS_URL=redis://localhost:6379
